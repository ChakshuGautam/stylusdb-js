{
  "name": "stylusdb",
  "version": "1.0.0",
  "description": "A minimalistic implementation of a distributed KV Store using Raft consensus",
  "main": "index.js",
  "scripts": {
    "test": "mocha 'raft/test/**/*.js' --timeout 10000 --exit",
    "test:watch": "mocha 'raft/test/**/*.js' --watch --timeout 10000",
    "test:coverage": "nyc npm test",
    "start": "node index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "outdated": "npm outdated"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChakshuGautam/stylusdb-js.git"
  },
  "author": "ChakshuGautam",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ChakshuGautam/stylusdb-js/issues"
  },
  "homepage": "https://github.com/ChakshuGautam/stylusdb-js#readme",
  "engines": {
    "node": ">=16.0.0 <19.0.0",
    "npm": ">=7.0.0"
  },
  "dependencies": {
    "argh": "0.1.x",
    "axon": "2.0.x",
    "diagnostics": "^2.0.2",
    "leveldown": "^6.1.1",
    "levelup": "^5.1.1",
    "node-lmdb": "^0.10.1",
    "promise-queue": "^2.2.5",
    "emits": "^3.0.0",
    "encoding-down": "^7.1.0",
    "eventemitter3": "^5.0.1",
    "extendible": "^0.1.1",
    "immediate": "^3.3.0",
    "millisecond": "^0.1.2",
    "modification": "^1.0.0",
    "one-time": "^1.0.0",
    "tick-tock": "^1.0.0",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "mocha": "^10.2.0",
    "chai": "^4.3.10",
    "assume": "^2.3.0",
    "nyc": "^15.1.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.3",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
